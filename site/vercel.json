{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {"api/portal.mjs": {"includeFiles": "private/**", "maxDuration": 30}},
  "rewrites": [
    {
      "source": "/",
      "has": [{"type": "host", "value": "download.kaan.win"}],
      "destination": "/api/portal?action=home"
    },
    {"source": "/", "destination": "/overview.html"},
    {"source": "/login", "destination": "/api/portal?action=login"},
    {"source": "/logout", "destination": "/api/portal?action=logout"},
    {"source": "/downloads/:file", "destination": "/api/portal?action=download&file=:file"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{"type": "host", "value": "download.kaan.win"}],
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet"}, {"key": "Cache-Control", "value": "private, no-store"}]
    },
    {
      "source": "/(.*)",
      "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]
    }
  ]
}
